# SkarPay environment
NODE_ENV=development
YOUPI_MODE=localhost

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API
API_PORT=4100
API_HOST=0.0.0.0
JWT_SECRET=change-me-in-prod

# Checkout / Admin (dev vite ports)
CHECKOUT_URL=http://localhost:5174
ADMIN_URL=http://localhost:5173

# Webhooks
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=5

# Observers (optional)
CHROME_CDP_URL=http://localhost:9222
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# WhatsApp (Baileys) - optional
WHATSAPP_ENABLED=false

# Admin console (required for merchant/admin endpoints)
ADMIN_API_KEY=change-me-to-a-long-random-key

# Observer security (enforce HMAC + enrollment tokens in production)
REQUIRE_SIGNED_OBSERVERS=true
REQUIRE_ENROLLMENT_TOKEN=true

# CORS (comma-separated origins for the admin/checkout frontends). Leave empty to allow all in dev.
CORS_ORIGINS=
